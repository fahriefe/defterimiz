rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Eşleşme kodları: kod bilinirse tek tek okunabilir (liste yok), bir kez oluşturulur, değiştirilemez.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
    }

    match /couples/{cid} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      // Üyeler okur; henüz tek kişilik çifti (katılmak için) herkes tek tek okuyabilir.
      allow get: if signedIn() && (isMember() || resource.data.members.size() < 2);
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (isMember()
        || (resource.data.members.size() == 1 && request.resource.data.members == resource.data.members.concat([request.auth.uid])));

      match /{sub}/{id} {
        function member() { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members; }
        allow read, write: if member();
      }
    }
  }
}
